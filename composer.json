{
  "name": "mittwald/symfony-ai-platform",
  "description": "Allows to use mittwald's AI Platform in your Symfony AI project.",
  "license": "MIT",
  "type": "symfony-ai-platform",
  "keywords": [
    "ai",
    "bridge",
    "platform",
    "openai",
    "mistral",
    "qwen3",
    "whisper",
    "glm"
  ],
  "homepage": "https://github.com/mittwald/symfony-ai-platform",
  "autoload": {
    "psr-4": {
      "Mittwald\\Symfony\\AI\\Platform\\Bridge\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Mittwald\\Symfony\\AI\\Platform\\Bridge\\Tests\\": "tests"
    }
  },
  "require": {
    "php": ">=8.2",
    "symfony/ai-platform": "^0.8",
    "symfony/http-client": "^7.3|^8.0",
    "symfony/mime": "^7.3|^8.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "phpstan/phpstan": "2.2.x-dev",
    "phpunit/phpunit": "^12.5"
  },
  "scripts": {
    "check": "phpstan analyse",
    "test": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration"
  }
}
